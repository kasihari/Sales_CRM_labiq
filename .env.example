# ---------------------------------------------------------------------------
# Lab IQ Sales — Environment Variables
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local`. NEVER put the service-role key in NEXT_PUBLIC_*.
# ---------------------------------------------------------------------------

# Supabase project URL (Project Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key (Project Settings -> API -> anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Google Maps JavaScript API key (Maps JavaScript API + Geocoding API enabled)
# Restrict this key by HTTP referrer in the Google Cloud console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-browser-key

# Service-role key — SERVER ONLY. Used only in scripts / server routes if needed.
# Do NOT prefix with NEXT_PUBLIC. Leave blank if unused.
SUPABASE_SERVICE_ROLE_KEY=
